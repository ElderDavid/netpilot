<?xml version="1.0" encoding="utf-8"?>
<!-- Sin copia en la nube ni transferencia entre dispositivos: la app solo guarda la última IP/puerto. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
